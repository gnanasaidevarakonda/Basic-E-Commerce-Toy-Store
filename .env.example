# ==============================================================================
# TOYVERSE E-COMMERCE MASTER ENVIRONMENT TEMPLATE
# Instructions: Copy this file to '.env' and adjust values for your environment.
#   - For Local Windows Dev:  Use Preset 1
#   - For Ubuntu WSL Staging: Use Preset 2
#   - For Production VPS:     Use Preset 3
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOCKER COMPOSE CONFIGURATION
# ------------------------------------------------------------------------------
# PRESET 1 (Local Dev):
COMPOSE_PROJECT_NAME=toystore_dev
WEB_PORT=8085
DB_PORT=3307

# PRESET 2 (Ubuntu WSL Staging - Uncomment when in ~/staging/):
# COMPOSE_PROJECT_NAME=toystore_staging
# WEB_PORT=8086
# DB_PORT=8088

# PRESET 3 (Production VPS - Uncomment when deploying to cloud):
# COMPOSE_PROJECT_NAME=toystore_prod
# WEB_PORT=80
# DB_PORT=3306

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8085

# ------------------------------------------------------------------------------
# 3. INTERNAL DATABASE CREDENTIALS (Inside Docker Network)
# ------------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_DATABASE=toystore_db
DB_USERNAME=toystore_user
DB_PASSWORD=toystore_password
DB_ROOT_PASSWORD=root_password

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_EXPIRATION_SECONDS=86400