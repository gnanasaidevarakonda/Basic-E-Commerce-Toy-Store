# ==========================================
# E-BIKE BACKEND CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file!
# ==========================================

# Application Environment (development | production)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database Configuration (Docker MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=toystore_db
DB_USERNAME=toystore_user
DB_PASSWORD=toystore_password
DB_ROOT_PASSWORD=your_secure_root_password

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_random_key_min_32_chars
JWT_EXPIRATION_SECONDS=86400

# 3rd-Party Mail Integration (SendGrid / Resend / SMTP)
MAIL_DRIVER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
MAIL_FROM_EMAIL=orders@yourdomain.com
MAIL_FROM_NAME="Toy Store"

# 3rd-Party SMS & WhatsApp Integration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number_here

# Payment Gateway (Stripe)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
