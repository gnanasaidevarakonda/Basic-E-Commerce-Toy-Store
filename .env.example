# ==============================================================================
# TOYVERSE MASTER CONFIGURATION BLUEPRINT (.env.example)
# Instructions:
#   1. Copy this file to create your active environment:
#        cp .env.example .env
#   2. Fill in your actual credentials and ports below for this specific machine.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Docker Orchestration
# ------------------------------------------------------------------------------
# Unique name prefix for Docker containers (prevents name collisions).
# Dev: toystore_dev | Staging: toystore_staging | Production: toystore_prod
COMPOSE_PROJECT_NAME=toystore_dev

# External Nginx Web Server Port on host machine
# Dev: 8085 | Staging: 8086 | Production: 80 (or 443 via reverse proxy)
HOST_WEB_PORT=8085

# External MySQL Port on host machine
# Dev: 3307 | Staging: 8088 | Production: 3306 (or unexposed)
HOST_DB_PORT=3307

# ------------------------------------------------------------------------------
# 2. Application Environment
# ------------------------------------------------------------------------------
# Options: development, staging, production
APP_ENV=development

# Detailed error stack traces (Always 'false' in production!)
APP_DEBUG=true

# Public Base URL of the API
# Dev: http://localhost:8085 | Staging: http://localhost:8086 | Production: https://yourdomain.com
APP_URL=http://localhost:8085

# ------------------------------------------------------------------------------
# 3. Internal Database (Docker Network)
# ------------------------------------------------------------------------------
# Service hostname matching 'db' in docker-compose.yml
DB_HOST=db
DB_PORT=3306
DB_DATABASE=toystore_db
DB_USERNAME=toystore_user
DB_PASSWORD=toystore_password
DB_ROOT_PASSWORD=root_password

# ------------------------------------------------------------------------------
# 4. Security & Authentication
# ------------------------------------------------------------------------------
# Cryptographic secret for signing JWT tokens (HMAC-SHA256). Minimum 32 characters.
# In Production: Generate with `openssl rand -base64 32`
JWT_SECRET=toystore_super_secret_jwt_key_replace_in_production_32chars!

# Token expiration time in seconds (86400 = 24 hours)
JWT_EXPIRATION_SECONDS=86400

# ------------------------------------------------------------------------------
# 5. Cloudinary Media Storage (CDN)
# ------------------------------------------------------------------------------
# Credentials from your Cloudinary dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here