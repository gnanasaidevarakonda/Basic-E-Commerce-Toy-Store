# ==============================================================================
# TOYVERSE CONFIGURATION BLUEPRINT (Placeholders Only - Safe for Git)
# ==============================================================================

# Docker Orchestration
COMPOSE_PROJECT_NAME=<project_name>
HOST_WEB_PORT=<external_web_port>
HOST_DB_PORT=<external_mysql_port>

# Application Environment
APP_ENV=<development|staging|production>
APP_DEBUG=<true|false>
APP_URL=<application_base_url>

# Internal Database (Docker Network)
DB_HOST=<db_service_name>
DB_PORT=<internal_mysql_port>
DB_DATABASE=<database_name>
DB_USERNAME=<database_user>
DB_PASSWORD=<database_password>
DB_ROOT_PASSWORD=<mysql_root_password>

# Security & Authentication
JWT_SECRET=<jwt_secret_minimum_32_characters>
JWT_EXPIRATION_SECONDS=<token_expiration_in_seconds>